{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheOneBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::himanshu-reports"
    },
    {
      "Sid": "ReadObjectsInIt",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::himanshu-reports/*"
    }
  ]
}
